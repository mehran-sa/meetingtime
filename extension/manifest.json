{
  "manifest_version": 3,
  "name": "Meeting Tracker for Slack Reminders",
  "short_name": "Meeting Tracker",
  "version": "1.0.0",
  "description": "Track meeting links from any page, see them in Bangladesh time, and copy the Slack reminder in one click.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Meeting Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage", "alarms", "notifications", "contextMenus"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open Meeting Tracker"
    }
  }
}
